# Python cache
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Pytest cache
.pytest_cache/

# IDE files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Dynamic runtime outputs (ignore contents but keep directory via .gitkeep)
output/*
!output/.gitkeep
reports/*
!reports/.gitkeep
screenshots/*
!screenshots/.gitkeep
logs/*
!logs/.gitkeep