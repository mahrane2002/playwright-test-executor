{
    "name": "test_form",
    "steps": [
        {
            "action": "open_browser",
            "variable": "browser"
        },
        {
            "action": "navigate",
            "browser": "browser",
            "url": "https://the-internet.herokuapp.com/forgot_password"
        },
        {
            "action": "find_element",
            "browser": "browser",
            "locator": "email",
            "variable": "email"
        },
        {
            "action": "fill",
            "element": "email",
            "value": "test@example.com"
        },
        {
            "action": "find_element",
            "browser": "browser",
            "locator": "retrieve_password",
            "variable": "__element_1"
        },
        {
            "action": "click",
            "element": "__element_1"
        },
        {
            "action": "wait",
            "duration": 2000
        },
        {
            "action": "close_browser",
            "browser": "browser"
        }
    ]
}