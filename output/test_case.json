{
    "name": "test_case",
    "steps": [
        {
            "action": "open_browser",
            "variable": "browser"
        },
        {
            "action": "navigate",
            "browser": "browser",
            "url": "https://the-internet.herokuapp.com/login"
        },
        {
            "action": "find_element",
            "browser": "browser",
            "locator": "username",
            "variable": "username"
        },
        {
            "action": "fill",
            "element": "username",
            "value": "tomsmith"
        },
        {
            "action": "find_element",
            "browser": "browser",
            "locator": "password",
            "variable": "password"
        },
        {
            "action": "fill",
            "element": "password",
            "value": "SuperSecretPassword!"
        },
        {
            "action": "find_element",
            "browser": "browser",
            "locator": "login",
            "variable": "__element_1"
        },
        {
            "action": "click",
            "element": "__element_1"
        },
        {
            "action": "wait",
            "duration": 2000
        },
        {
            "action": "close_browser",
            "browser": "browser"
        }
    ]
}